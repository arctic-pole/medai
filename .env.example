# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://medai:medai@localhost:5432/medai
POSTGRES_USER=medai
POSTGRES_PASSWORD=medai
POSTGRES_DB=medai

# --- Auth ---
JWT_SECRET_KEY=change-me-in-real-environments-min-32-bytes-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Fernet key for application-level encryption of sensitive DB columns.
# Generate a real one with: from cryptography.fernet import Fernet; Fernet.generate_key()
FIELD_ENCRYPTION_KEY=kgcgyGwg_TOkwTOdpCClu340NKpRIVU15x2EeNDDtqg=

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Provider credentials ---
# LLMProvider: Gemini (active choice). Leave blank to run with extraction/reasoning disabled
# (app/providers/llm/gemini_provider.py fails closed rather than fabricating output).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# OpenAIProvider is a second working LLMProvider implementation, kept but not selected by
# get_llm_provider() — set these only if you switch app/providers/llm/__init__.py back to it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# STT: on-device (Flutter speech_to_text) — no backend credential needed.
# TTS: flutter_tts, Phase 11, not yet built.
# Embeddings: BAAI/bge-large-en-v1.5 via sentence-transformers, self-hosted — no credential.
# Medical knowledge: MedlinePlus web service, Phase 5 — no credential.
